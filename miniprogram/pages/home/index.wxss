.page { padding: 32rpx; padding-block-end: 48rpx; max-width: 1000rpx; margin-inline: auto; }
.row { display: flex; align-items: center; }
.header, .section-head { justify-content: space-between; gap: 16rpx; }
.header { margin-block-end: 16rpx; }
.title { font-size: 52rpx; font-weight: 700; margin-block-start: 6rpx; }
.eyebrow { font-size: 20rpx; letter-spacing: 2rpx; color: #51766f; }
.period, .muted { color: #738780; }
.period { font-size: 24rpx; margin-block-end: 32rpx; }
.card { background: #ffffff; border: 1rpx solid #e2ece7; border-radius: 28rpx; padding: 30rpx; margin-block-end: 24rpx; }
.hero { background: #e8f1ec; text-align: center; padding-block: 42rpx 24rpx; }
.hero-title { font-size: 40rpx; font-weight: 700; margin-block: 16rpx; }
.hero .muted { font-size: 24rpx; }
.button { padding-inline: 26rpx; line-height: 2.6; font-weight: 600; }
.primary { color: #fff; background: #296653; }
.secondary { color: #296653; background: #eaf1ed; }
.compact { font-size: 24rpx; flex-shrink: 0; }
.checkin { margin-block-start: 30rpx; }
.text-button { color: #376e5d; background: transparent; font-size: 24rpx; line-height: 2.6; padding-inline: 12rpx; }
.stats { gap: 20rpx; align-items: stretch; }
.stat { flex: 1; min-width: 0; padding: 28rpx 24rpx; }
.stat-number { font-size: 66rpx; font-weight: 700; margin-block: 8rpx; }
.unit { font-size: 26rpx; font-weight: 400; color: #738780; }
.small { font-size: 23rpx; line-height: 1.65; }
.section-title { font-size: 30rpx; font-weight: 700; }
.badge { color: #4b7a67; background: #edf4ef; border-radius: 10rpx; padding: 7rpx 12rpx; font-size: 21rpx; flex-shrink: 0; }
.goal-number { font-size: 54rpx; font-weight: 700; margin-block: 24rpx 16rpx; }
.track { height: 14rpx; background: #eaf0eb; border-radius: 20rpx; overflow: hidden; }
.fill { height: 100%; background: #63967a; border-radius: 20rpx; }
.goal-caption { margin-block: 20rpx 6rpx; font-size: 25rpx; }
.threshold { margin-block-start: 30rpx; }
.threshold .track { margin-block-start: 14rpx; }
.caption { margin-block-start: 8rpx; }
.strong { font-weight: 600; }
.months-card { padding-block-end: 14rpx; }
.month-row { border-block-start: 1rpx solid #eaf0eb; padding-block: 26rpx; margin-block-start: 20rpx; }
.month-row.current { border-block-start-color: #9cbca9; }
.month-count { justify-content: flex-end; gap: 10rpx; font-size: 24rpx; margin-block: 16rpx; }
.target-input { width: 90rpx; height: 60rpx; background: #f1f5f2; border: 1rpx solid #d9e5dc; border-radius: 10rpx; text-align: center; font-size: 28rpx; }
.mini { height: 8rpx; }
.record { padding-block-start: 24rpx; border-block-start: 1rpx solid #edf1ee; margin-block-start: 22rpx; }
.record-actions { justify-content: flex-end; gap: 20rpx; }
.danger { color: #b3493d; }
.empty { color: #738780; text-align: center; padding-block: 42rpx; font-size: 25rpx; }
.footer { color: #8a9a92; text-align: center; font-size: 22rpx; padding-block: 16rpx; }
.backup-copy { margin-block: 12rpx 20rpx; }
.backup-actions { gap: 16rpx; }
.backup-actions .button { flex: 1; }
.date-entry { margin-block-start: 16rpx; padding-block-start: 20rpx; border-block-start: 1rpx solid #cfded4; }
.date-value { background: #f2f6f3; padding: 20rpx; border-radius: 12rpx; color: #244f43; }
.actions { gap: 16rpx; margin-block-start: 16rpx; }
.actions .button { flex: 1; }
.modal-mask { position: fixed; inset: 0; z-index: 10; background: rgba(15, 37, 30, .4); display: flex; justify-content: center; align-items: center; padding: 30rpx; }
.modal { width: 100%; max-width: 800rpx; background: #ffffff; border-radius: 28rpx; padding: 30rpx; }
.settings-fields { max-height: 65vh; }
.field { margin-block-end: 24rpx; }
.field > text { display: block; margin-block-end: 12rpx; font-size: 25rpx; color: #647e72; }
.field input { height: 80rpx; padding-inline: 20rpx; border: 1rpx solid #d9e5dc; border-radius: 12rpx; background: #f7f9f7; }
.save-settings { margin-block-start: 24rpx; }
